# ---------------------------------------------------------------------------
# Scaleway API credentials
# https://console.scaleway.com/project/credentials
# These four are consumed directly by the `scw` CLI binary (standard scw
# env vars) -- app.py never reads them itself. Required for every scw call
# this app makes (list/create/update/delete-rule) to succeed.
# ---------------------------------------------------------------------------
# Required.
SCW_ACCESS_KEY=
# Required.
SCW_SECRET_KEY=
# Required (most accounts authenticate by project).
SCW_DEFAULT_PROJECT_ID=
# Required on older/organization-based Scaleway accounts; otherwise optional.
SCW_DEFAULT_ORGANIZATION_ID=
# Optional -- default: fr-par-1. Also read directly by app.py (as ZONE) for
# every list/create/update/delete-rule call.
SCW_DEFAULT_ZONE=fr-par-1

# ---------------------------------------------------------------------------
# Core config
# ---------------------------------------------------------------------------
# Required. The security group(s) this endpoint manages. Comma-separated to
# manage several groups from one link -- e.g. several servers behind
# different groups that should all open to the same visiting IP at once:
#   SECURITY_GROUP_ID=11111111-1111-1111-1111-111111111111,22222222-2222-2222-2222-222222222222
# Every group listed gets the same port/IP/days applied on each request.
# This value is also the URL path token (spaces around commas are ignored
# when building that URL, so "id1, id2" still becomes .../id1,id2) --
# keep the resulting URL as private as a password.
#
# Multi-project / multi-region is NOT supported here: SCW_DEFAULT_ZONE,
# the credentials above, and FORBIDDEN_PORTS/MAX_DAYS below are all
# process-wide, not per-group. So every group listed must live in the same
# zone and be reachable with the same credentials, and all of them get the
# same port/IP/days/policy on every request -- you can't target just one
# group, or give different groups different rules. A security group in a
# different zone or project needs its own separate deployment (own .env,
# own docker-compose service, own volume, own URL), not another entry here.
SECURITY_GROUP_ID=

# Optional -- default: empty (no restriction, any port 1-65535 may be
# requested). Ports this endpoint may never open, comma-separated; ranges
# allowed. ?port= is required on every request regardless -- there is no
# default port. Example below blocks SSH/Telnet, Docker/k8s/etcd admin APIs
# (unauthenticated = full host compromise), common databases (no/weak auth
# by default), RDP/VNC/WinRM, and SMB/NetBIOS file sharing. Trim to what you
# actually run.
FORBIDDEN_PORTS=22,23,445,139,2375,2376,2379-2380,6443,10250,3306,5432,1433,6379,27017,9200,11211,3389,5900-5901,5985-5986

# Optional -- default: 30. Upper bound accepted for the optional &days= URL
# param (the rule auto-deletes itself N days after being requested).
MAX_DAYS=30

# ---------------------------------------------------------------------------
# Advanced overrides -- defaults shown are app.py's built-in fallbacks.
# The Docker image sets its own defaults for the *_LOG/*_FILE paths (under
# /data, the persisted volume) via the Dockerfile, so uncomment these only
# to override those image defaults too.
# ---------------------------------------------------------------------------
# Optional -- default: 0.0.0.0 (listen on all interfaces).
# LISTEN_HOST=0.0.0.0
# Optional -- default: 8080.
# LISTEN_PORT=8080
# Optional -- default: /usr/bin/scw bare-metal, /usr/local/bin/scw in Docker.
# SCW_BIN=/usr/local/bin/scw
# Optional -- default: created_rules.log bare-metal, /data/created_rules.log
# in Docker. Append-only audit trail of every rule this app has created
# (not ones it only updated) -- see README for using it to clean up.
# CREATED_RULES_LOG=/data/created_rules.log
# Optional -- default: rule_expirations.json bare-metal,
# /data/rule_expirations.json in Docker. Tracks rules created with &days=
# until they're deleted; must live on persistent storage or a restart loses
# track of pending expirations.
# RULE_EXPIRY_FILE=/data/rule_expirations.json
# Optional -- default: 300 (seconds). How often the background sweep checks
# for expired rules to delete.
# RULE_EXPIRY_INTERVAL=300
