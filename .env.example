# Scaleway API credentials (https://console.scaleway.com/project/credentials)
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_DEFAULT_PROJECT_ID=
SCW_DEFAULT_ORGANIZATION_ID=
SCW_DEFAULT_ZONE=fr-par-1

# Target security group. This value is also the URL path token -- keep the
# resulting URL as private as a password.
SECURITY_GROUP_ID=

# ?port= is required on every request -- there is no default port.
# Ports this endpoint may never open, comma-separated; ranges allowed.
# Covers: SSH/Telnet, Docker/k8s/etcd admin APIs (unauthenticated = full host
# compromise), common databases (no/weak auth by default), RDP/VNC/WinRM,
# and SMB/NetBIOS file sharing. Trim to what you actually run.
FORBIDDEN_PORTS=22,23,445,139,2375,2376,2379-2380,6443,10250,3306,5432,1433,6379,27017,9200,11211,3389,5900-5901,5985-5986
# Upper bound accepted for the optional &days= URL param (auto-delete after N days).
MAX_DAYS=30

# Optional overrides (defaults shown)
# LISTEN_HOST=0.0.0.0
# LISTEN_PORT=8080
# CREATED_RULES_LOG=/data/created_rules.log
# RULE_EXPIRY_FILE=/data/rule_expirations.json
# RULE_EXPIRY_INTERVAL=300
